{
    "name": "steel-mcp",
    "mcpName": "dev.steel/mcp-server",
    "version": "2.0.0",
    "description": "MCP server for Steel cloud browsers: read, screenshot and act on any website, including ones that block plain fetch",
    "license": "MIT",
    "author": "Steel (https://steel.dev)",
    "homepage": "https://steel.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/steel-dev/steel-mcp-server.git"
    },
    "bugs": "https://github.com/steel-dev/steel-mcp-server/issues",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "bin": {
        "steel-mcp": "dist/stdio.js"
    },
    "main": "./dist/core/index.js",
    "exports": {
        ".": "./dist/core/index.js",
        "./hosted": "./dist/hosted.js",
        "./hosted-runtime": "./dist/hosted-runtime.js",
        "./http": "./dist/http.js",
        "./stdio": "./dist/stdio.js",
        "./tracing": "./dist/tracing.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/stdio.js', 0o755)\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "test": "vitest run --project unit --project integration",
        "test:unit": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "test:browser": "vitest run --project browser",
        "test:e2e": "./scripts/run-e2e.sh",
        "test:e2e:direct": "vitest run --project e2e",
        "test:watch": "vitest",
        "conformance": "npm run build && ./scripts/run-conformance.sh",
        "budget": "vitest run --project budget",
        "pack:mcpb": "./scripts/pack-mcpb.sh",
        "sync:version": "node scripts/sync-version.mjs",
        "version": "node scripts/sync-version.mjs && git add src/core/version.ts manifest.json README.md",
        "start": "node dist/stdio.js",
        "start:hosted": "node dist/hosted.js",
        "prepare": "npm run build",
        "test:smoke": "vitest run --project smoke"
    },
    "dependencies": {
        "@modelcontextprotocol/server": "2.0.0",
        "@opentelemetry/api": "^1.9.1",
        "safe-regex2": "5.1.1",
        "ws": "^8.21.2",
        "zod": "^4.2.0"
    },
    "peerDependencies": {
        "@modelcontextprotocol/node": "2.0.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
        "@opentelemetry/sdk-node": "^0.221.0",
        "ioredis": "^5.11.1"
    },
    "peerDependenciesMeta": {
        "@modelcontextprotocol/node": {
            "optional": true
        },
        "@opentelemetry/exporter-trace-otlp-http": {
            "optional": true
        },
        "@opentelemetry/sdk-node": {
            "optional": true
        },
        "ioredis": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@modelcontextprotocol/client": "2.0.0",
        "@modelcontextprotocol/conformance": "0.2.0-alpha.10",
        "@modelcontextprotocol/node": "2.0.0",
        "@opentelemetry/context-async-hooks": "^2.10.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
        "@opentelemetry/sdk-node": "^0.221.0",
        "@opentelemetry/sdk-trace-base": "^2.10.0",
        "@types/node": "^26.1.2",
        "@types/ws": "^8.18.1",
        "ioredis": "^5.11.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "keywords": [
        "mcp",
        "modelcontextprotocol",
        "steel",
        "browser",
        "automation",
        "scraping",
        "headless-chrome"
    ]
}
